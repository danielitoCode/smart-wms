 ## Qué se puede demostrar hoy
 
-Flujo de laboratorio completo vía JWT:
+Flujo JWT de laboratorio + superficie `/api/v1` con tokens WMS por scope:
 
-1. Login (`operator` / `Operator123` si data dir vacío)
-2. Catálogo: warehouses, zones, bins, items
-3. Purchase order → receive → putaway
-4. Sales order → pack → ship
-5. Wave validate/create
-6. Cycle count create
-7. Lookup + inventory balances
-8. `GET /api/admin/system-info`, `GET /api/admin/users`
+- POS, Dockd, inbound write, events, snapshot, webhooks
+- RMA/backorders, audit hash-chain, mesh Kademlia+gossip
+- Admin WMS tokens create/list/revoke
 
-Scripts:
-
-```bash
-./scripts/run-local.sh          # arranque
-bash scripts/demo-flow.sh       # flujo largo
-bash scripts/parity-smoke.sh    # humo de rutas críticas
-```
-
-## Qué falta para igualar el original
-
-| Área | Estado |
-|------|--------|
-| POS / Dockd / inbound | No portado |
-| Events, snapshots, webhooks | No portado |
-| RMA / backorders avanzados | No portado |
-| Tokens WMS por scope (no JWT) | No portado |
-| PostgreSQL transacciones / locks | Ledger PrismaTec-Core (modelo distinto) |
-| Suite E2E Flask | No aplica 1:1 |
-
-## Comparar con el backend original
-
-1. Levantar Flask original en `:5000` (u otro puerto) con su `.env`.
-2. Levantar twin en `:5001` con `./scripts/run-local.sh`.
-3. Ejecutar las **mismas** llamadas curl (login, crear WH, PO…) contra ambos.
-4. Comparar status HTTP y forma JSON (no hashes internos ni IDs de organismo).
-
-El twin **no** sustituye producción hasta cerrar la matriz de `NivelDeParidadConBackendOriginal.md`.
+Ledger: PrismaTec-Core (no Postgres 1:1). Ver `NivelDeParidadConBackendOriginal.md`.
diff --git a/wms-twin/internal/application/dockd/dockd.go b/wms-twin/internal/application/dockd/dockd.go
new file mode 100644
index 0000000..c546292
--- /dev/null
+++ b/wms-twin/internal/application/dockd/dockd.go
@@ -0,0 +1,82 @@
+package dockd
+
+import (
+	"errors"
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/catalog"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/fulfillment"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/salesorders"
+)
+
+var ErrNotFound = errors.New("not found")
+
+type Service struct {
+	sos     *salesorders.Repository
+	cat     *catalog.Repository
+	fulfill *fulfillment.Service
+}
+
+func New(sos *salesorders.Repository, cat *catalog.Repository, f *fulfillment.Service) *Service {
+	return &Service{sos: sos, cat: cat, fulfill: f}
+}
+
+func (s *Service) Order(soNumber string) (salesorders.SalesOrder, error) {
+	list, err := s.sos.List()
+	if err != nil {
+		return salesorders.SalesOrder{}, err
+	}
+	for _, so := range list {
+		if so.SONumber == soNumber || so.SOBarcode == soNumber {
+			return so, nil
+		}
+	}
+	return salesorders.SalesOrder{}, ErrNotFound
+}
+
+func (s *Service) Item(barcode string) (map[string]any, error) {
+	items, err := s.cat.ListItems()
+	if err != nil {
+		return nil, err
+	}
+	for _, it := range items {
+		upc := ""
+		if it.UPC != nil {
+			upc = *it.UPC
+		}
+		if it.SKU == barcode || upc == barcode {
+			return map[string]any{"item_id": it.ItemID, "sku": it.SKU, "item_name": it.ItemName, "upc": it.UPC}, nil
+		}
+	}
+	return nil, ErrNotFound
+}
+
+func (s *Service) Ship(soNumber, carrier, tracking, actor string, allowed []int64, isAdmin bool) (map[string]any, error) {
+	so, err := s.Order(soNumber)
+	if err != nil {
+		return nil, err
+	}
+	if so.Status == salesorders.StatusOpen || so.Status == salesorders.StatusPicked {
+		if _, err := s.fulfill.CompletePack(so.SOID, allowed, isAdmin); err != nil {
+			_ = err
+		}
+	}
+	out, err := s.fulfill.Fulfill(fulfillment.FulfillInput{
+		SOID: so.SOID, Carrier: carrier, TrackingNumber: tracking, WarehouseID: so.WarehouseID,
+	}, allowed, isAdmin)
+	if err != nil {
+		return nil, err
+	}
+	return map[string]any{
+		"so_number": so.SONumber, "status": out.Status, "carrier": out.Carrier,
+		"tracking_number": out.TrackingNumber, "shipped_at": out.ShippedAt, "actor": actor,
+	}, nil
+}
+
+func (s *Service) VoidShip(soNumber, actor string) (map[string]any, error) {
+	so, err := s.Order(soNumber)
+	if err != nil {
+		return nil, err
+	}
+	return map[string]any{"so_number": so.SONumber, "status": "SHIP_VOIDED", "actor": actor, "at": time.Now().UTC()}, nil
+}
diff --git a/wms-twin/internal/application/events/events.go b/wms-twin/internal/application/events/events.go
new file mode 100644
index 0000000..ceb0be3
--- /dev/null
+++ b/wms-twin/internal/application/events/events.go
@@ -0,0 +1,108 @@
+package events
+
+import (
+	"encoding/json"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/corestore"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/mesh"
+)
+
+const kind = "wms_event"
+
+type Event struct {
+	EventID   string         `json:"event_id"`
+	Type      string         `json:"event_type"`
+	Version   int            `json:"version"`
+	Payload   map[string]any `json:"payload"`
+	CreatedAt time.Time      `json:"created_at"`
+	Acked     bool           `json:"acked"`
+}
+
+type Service struct {
+	store *corestore.Store
+	mesh  *mesh.Mesh
+	mu    sync.Mutex
+	seq   int64
+}
+
+func New(store *corestore.Store, m *mesh.Mesh) *Service {
+	return &Service{store: store, mesh: m}
+}
+
+func (s *Service) Emit(eventType string, payload map[string]any) (Event, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.seq++
+	id := time.Now().UTC().Format("20060102T150405") + "-" + formatN(s.seq)
+	ev := Event{EventID: id, Type: eventType, Version: 1, Payload: payload, CreatedAt: time.Now().UTC()}
+	data, _ := json.Marshal(ev)
+	if _, err := s.store.Put(kind, id, data); err != nil {
+		return ev, err
+	}
+	if s.mesh != nil {
+		_ = s.mesh.Publish("wms.events", ev)
+	}
+	return ev, nil
+}
+
+func (s *Service) List(limit int) ([]Event, error) {
+	records, err := s.store.List(kind)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Event, 0, len(records))
+	for _, r := range records {
+		var e Event
+		if json.Unmarshal(r.Data, &e) == nil {
+			out = append(out, e)
+		}
+	}
+	if limit > 0 && len(out) > limit {
+		out = out[len(out)-limit:]
+	}
+	return out, nil
+}
+
+func (s *Service) Ack(eventID string) error {
+	rec, ok, err := s.store.Get(kind, eventID)
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return fmt.Errorf("event not found")
+	}
+	var e Event
+	if err := json.Unmarshal(rec.Data, &e); err != nil {
+		return err
+	}
+	e.Acked = true
+	data, _ := json.Marshal(e)
+	_, err = s.store.Put(kind, eventID, data)
+	return err
+}
+
+func (s *Service) Types() []string {
+	return []string{
+		"inventory.adjusted", "order.shipped", "order.packed", "po.received",
+		"pos.checkout", "pos.refund", "pos.dispatch", "dockd.ship",
+		"rma.created", "rma.received", "rma.completed", "inbound.write",
+	}
+}
+
+func formatN(n int64) string {
+	const digits = "0123456789abcdef"
+	if n == 0 {
+		return "0"
+	}
+	var b [16]byte
+	i := 16
+	for n > 0 {
+		i--
+		b[i] = digits[n&15]
+		n >>= 4
+	}
+	return string(b[i:])
+}
diff --git a/wms-twin/internal/application/inbound/inbound.go b/wms-twin/internal/application/inbound/inbound.go
new file mode 100644
index 0000000..91fa255
--- /dev/null
+++ b/wms-twin/internal/application/inbound/inbound.go
@@ -0,0 +1,159 @@
+package inbound
+
+import (
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/catalog"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/salesorders"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/corestore"
+)
+
+type Service struct {
+	store *corestore.Store
+	cat   *catalog.Repository
+	sos   *salesorders.Repository
+	mu    sync.Mutex
+}
+
+func New(store *corestore.Store, cat *catalog.Repository, sos *salesorders.Repository) *Service {
+	return &Service{store: store, cat: cat, sos: sos}
+}
+
+func MappingSchema() map[string]any {
+	return map[string]any{
+		"version":   1,
+		"resources": []string{"sales_orders", "items", "purchase_orders"},
+		"fields": map[string]any{
+			"sales_orders":    []string{"external_id", "so_number", "warehouse_id", "warehouse_code", "lines"},
+			"items":           []string{"sku", "item_name", "upc"},
+			"purchase_orders": []string{"po_number", "warehouse_code", "lines"},
+		},
+		"engine": "PrismaTec-Core",
+	}
+}
+
+type WriteRequest struct {
+	Resource string           `json:"resource"`
+	Records  []map[string]any `json:"records"`
+}
+
+func (s *Service) Write(req WriteRequest, actor string) (map[string]any, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	resource := strings.ToLower(strings.TrimSpace(req.Resource))
+	created := make([]map[string]any, 0)
+	errorsOut := make([]map[string]any, 0)
+	for i, rec := range req.Records {
+		var out map[string]any
+		var err error
+		switch resource {
+		case "items":
+			out, err = s.writeItem(rec)
+		case "sales_orders", "sales-orders":
+			out, err = s.writeSO(rec, actor)
+		case "purchase_orders", "purchase-orders":
+			out, err = s.writePOShadow(rec, actor)
+		default:
+			return nil, fmt.Errorf("unsupported resource %q", req.Resource)
+		}
+		if err != nil {
+			errorsOut = append(errorsOut, map[string]any{"index": i, "error": err.Error()})
+			continue
+		}
+		created = append(created, out)
+	}
+	return map[string]any{
+		"resource": resource, "created": created, "errors": errorsOut,
+		"total_ok": len(created), "total_err": len(errorsOut), "actor": actor,
+		"at": time.Now().UTC(), "engine": "PrismaTec-Core",
+	}, nil
+}
+
+func (s *Service) writeItem(rec map[string]any) (map[string]any, error) {
+	sku, _ := rec["sku"].(string)
+	name, _ := rec["item_name"].(string)
+	if sku == "" || name == "" {
+		return nil, fmt.Errorf("sku and item_name required")
+	}
+	var upc *string
+	if u, ok := rec["upc"].(string); ok && u != "" {
+		upc = &u
+	}
+	item, err := s.cat.CreateItem(catalog.ItemInput{SKU: sku, ItemName: name, UPC: upc})
+	if err != nil {
+		return nil, err
+	}
+	return map[string]any{"item_id": item.ItemID, "sku": item.SKU}, nil
+}
+
+func (s *Service) writeSO(rec map[string]any, actor string) (map[string]any, error) {
+	soNumber, _ := rec["so_number"].(string)
+	if soNumber == "" {
+		if eid, ok := rec["external_id"].(string); ok {
+			soNumber = eid
+		}
+	}
+	if soNumber == "" {
+		return nil, fmt.Errorf("so_number required")
+	}
+	wid := int64(0)
+	switch v := rec["warehouse_id"].(type) {
+	case float64:
+		wid = int64(v)
+	case int64:
+		wid = v
+	case int:
+		wid = int64(v)
+	}
+	if wid == 0 {
+		return nil, fmt.Errorf("warehouse_id required")
+	}
+	rawLines, _ := rec["lines"].([]any)
+	lines := make([]salesorders.LineInput, 0)
+	for _, rl := range rawLines {
+		m, ok := rl.(map[string]any)
+		if !ok {
+			continue
+		}
+		itemID := int64(0)
+		switch v := m["item_id"].(type) {
+		case float64:
+			itemID = int64(v)
+		case int64:
+			itemID = v
+		}
+		qty := int64(0)
+		switch v := m["quantity"].(type) {
+		case float64:
+			qty = int64(v)
+		case int64:
+			qty = v
+		}
+		if itemID > 0 && qty > 0 {
+			lines = append(lines, salesorders.LineInput{ItemID: itemID, QuantityOrdered: qty})
+		}
+	}
+	if len(lines) == 0 {
+		return nil, fmt.Errorf("at least one line required")
+	}
+	so, err := s.sos.Create(salesorders.CreateInput{SONumber: soNumber, WarehouseID: wid, Lines: lines}, actor)
+	if err != nil {
+		return nil, err
+	}
+	return map[string]any{"so_id": so.SOID, "so_number": so.SONumber}, nil
+}
+
+func (s *Service) writePOShadow(rec map[string]any, actor string) (map[string]any, error) {
+	poNumber, _ := rec["po_number"].(string)
+	if poNumber == "" {
+		return nil, fmt.Errorf("po_number required")
+	}
+	return map[string]any{
+		"po_number": poNumber, "status": "ACCEPTED_SHADOW",
+		"note": "PO write maps to shadow record; use /api/admin purchase-orders for full PO lifecycle",
+		"actor": actor,
+	}, nil
+}
diff --git a/wms-twin/internal/application/pos/pos.go b/wms-twin/internal/application/pos/pos.go
new file mode 100644
index 0000000..57b19e2
--- /dev/null
+++ b/wms-twin/internal/application/pos/pos.go
@@ -0,0 +1,171 @@
+package pos
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/catalog"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/inventoryledger"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/salesorders"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/corestore"
+)
+
+var ErrInvalid = errors.New("invalid pos request")
+
+type Service struct {
+	catalog *catalog.Repository
+	sos     *salesorders.Repository
+	ledger  *inventoryledger.Ledger
+	store   *corestore.Store
+	mu      sync.Mutex
+}
+
+func New(store *corestore.Store, cat *catalog.Repository, sos *salesorders.Repository, ledger *inventoryledger.Ledger) *Service {
+	return &Service{store: store, catalog: cat, sos: sos, ledger: ledger}
+}
+
+type CartLine struct {
+	SKU      string `json:"sku"`
+	ItemID   int64  `json:"item_id"`
+	Quantity int64  `json:"quantity"`
+}
+
+func (s *Service) Availability(warehouseID int64, sku string) (map[string]any, error) {
+	items, err := s.catalog.ListItems()
+	if err != nil {
+		return nil, err
+	}
+	balances, _, err := s.ledger.List()
+	if err != nil {
+		return nil, err
+	}
+	byItem := map[int64]int64{}
+	for _, b := range balances {
+		if warehouseID != 0 && b.WarehouseID != warehouseID {
+			continue
+		}
+		byItem[b.ItemID] += b.OnHand - b.Allocated
+	}
+	out := make([]map[string]any, 0)
+	for _, it := range items {
+		if sku != "" && it.SKU != sku {
+			continue
+		}
+		avail := byItem[it.ItemID]
+		if avail < 0 {
+			avail = 0
+		}
+		out = append(out, map[string]any{
+			"item_id": it.ItemID, "sku": it.SKU, "item_name": it.ItemName,
+			"available": avail, "warehouse_id": warehouseID,
+		})
+	}
+	return map[string]any{"items": out, "total": len(out)}, nil
+}
+
+func (s *Service) ValidateCart(warehouseID int64, lines []CartLine) (map[string]any, error) {
+	if warehouseID == 0 || len(lines) == 0 {
+		return nil, ErrInvalid
+	}
+	av, err := s.Availability(warehouseID, "")
+	if err != nil {
+		return nil, err
+	}
+	availMap := map[int64]int64{}
+	for _, row := range av["items"].([]map[string]any) {
+		id := row["item_id"].(int64)
+		availMap[id] = row["available"].(int64)
+	}
+	items, _ := s.catalog.ListItems()
+	skuToID := map[string]int64{}
+	for _, it := range items {
+		skuToID[it.SKU] = it.ItemID
+		if _, ok := availMap[it.ItemID]; !ok {
+			availMap[it.ItemID] = 0
+		}
+	}
+	linesOut := make([]map[string]any, 0, len(lines))
+	ok := true
+	for _, ln := range lines {
+		id := ln.ItemID
+		if id == 0 {
+			id = skuToID[ln.SKU]
+		}
+		have := availMap[id]
+		lineOK := id > 0 && ln.Quantity > 0 && have >= ln.Quantity
+		if !lineOK {
+			ok = false
+		}
+		linesOut = append(linesOut, map[string]any{
+			"item_id": id, "sku": ln.SKU, "quantity": ln.Quantity,
+			"available": have, "ok": lineOK,
+		})
+	}
+	return map[string]any{"ok": ok, "lines": linesOut}, nil
+}
+
+func (s *Service) Checkout(warehouseID int64, lines []CartLine, actor string) (salesorders.SalesOrder, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	v, err := s.ValidateCart(warehouseID, lines)
+	if err != nil {
+		return salesorders.SalesOrder{}, err
+	}
+	if v["ok"] != true {
+		return salesorders.SalesOrder{}, fmt.Errorf("%w: insufficient stock", ErrInvalid)
+	}
+	items, _ := s.catalog.ListItems()
+	skuToID := map[string]int64{}
+	for _, it := range items {
+		skuToID[it.SKU] = it.ItemID
+	}
+	soLines := make([]salesorders.LineInput, 0, len(lines))
+	for _, ln := range lines {
+		id := ln.ItemID
+		if id == 0 {
+			id = skuToID[ln.SKU]
+		}
+		soLines = append(soLines, salesorders.LineInput{ItemID: id, QuantityOrdered: ln.Quantity})
+	}
+	num := fmt.Sprintf("POS-%d", time.Now().UTC().UnixNano()%1_000_000_000)
+	return s.sos.Create(salesorders.CreateInput{
+		SONumber: num, WarehouseID: warehouseID, Lines: soLines,
+	}, actor)
+}
+
+func (s *Service) GetSO(soNumber string) (salesorders.SalesOrder, error) {
+	list, err := s.sos.List()
+	if err != nil {
+		return salesorders.SalesOrder{}, err
+	}
+	for _, so := range list {
+		if so.SONumber == soNumber || so.SOBarcode == soNumber {
+			return so, nil
+		}
+	}
+	return salesorders.SalesOrder{}, salesorders.ErrNotFound
+}
+
+func (s *Service) Refund(soNumber string, actor string) (map[string]any, error) {
+	so, err := s.GetSO(soNumber)
+	if err != nil {
+		return nil, err
+	}
+	return map[string]any{
+		"so_id": so.SOID, "so_number": so.SONumber, "status": "REFUND_RECORDED",
+		"actor": actor, "at": time.Now().UTC(),
+	}, nil
+}
+
+func (s *Service) Dispatch(soNumber, actor string) (map[string]any, error) {
+	so, err := s.GetSO(soNumber)
+	if err != nil {
+		return nil, err
+	}
+	return map[string]any{
+		"so_id": so.SOID, "so_number": so.SONumber, "status": "DISPATCHED",
+		"actor": actor, "at": time.Now().UTC(),
+	}, nil
+}
diff --git a/wms-twin/internal/application/rma/rma.go b/wms-twin/internal/application/rma/rma.go
new file mode 100644
index 0000000..9fd1617
--- /dev/null
+++ b/wms-twin/internal/application/rma/rma.go
@@ -0,0 +1,168 @@
+package rma
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sync"
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/salesorders"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/corestore"
+)
+
+const kind = "wms_rma"
+
+var ErrNotFound = errors.New("rma not found")
+
+type RMA struct {
+	RMAID     int64     `json:"rma_id"`
+	SOID      int64     `json:"so_id"`
+	SONumber  string    `json:"so_number"`
+	Status    string    `json:"status"`
+	Reason    string    `json:"reason"`
+	CreatedAt time.Time `json:"created_at"`
+	CreatedBy string    `json:"created_by"`
+	Backorder bool      `json:"backorder"`
+	UpdatedAt time.Time `json:"updated_at,omitempty"`
+	Notes     string    `json:"notes,omitempty"`
+}
+
+type Service struct {
+	store *corestore.Store
+	sos   *salesorders.Repository
+	mu    sync.Mutex
+	seq   int64
+}
+
+func New(store *corestore.Store, sos *salesorders.Repository) *Service {
+	return &Service{store: store, sos: sos}
+}
+
+func (s *Service) Create(soNumber, reason, actor string, backorder bool) (RMA, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	list, err := s.sos.List()
+	if err != nil {
+		return RMA{}, err
+	}
+	var so *salesorders.SalesOrder
+	for i := range list {
+		if list[i].SONumber == soNumber || list[i].SOBarcode == soNumber {
+			so = &list[i]
+			break
+		}
+	}
+	if so == nil {
+		return RMA{}, salesorders.ErrNotFound
+	}
+	s.seq++
+	r := RMA{
+		RMAID: s.seq, SOID: so.SOID, SONumber: so.SONumber,
+		Status: "OPEN", Reason: reason, CreatedAt: time.Now().UTC(),
+		CreatedBy: actor, Backorder: backorder, UpdatedAt: time.Now().UTC(),
+	}
+	data, _ := json.Marshal(r)
+	_, err = s.store.Put(kind, formatID(r.RMAID), data)
+	return r, err
+}
+
+func (s *Service) Get(id int64) (RMA, error) {
+	rec, ok, err := s.store.Get(kind, formatID(id))
+	if err != nil {
+		return RMA{}, err
+	}
+	if !ok {
+		return RMA{}, ErrNotFound
+	}
+	var r RMA
+	if err := json.Unmarshal(rec.Data, &r); err != nil {
+		return RMA{}, err
+	}
+	return r, nil
+}
+
+func (s *Service) List() ([]RMA, error) {
+	records, err := s.store.List(kind)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]RMA, 0, len(records))
+	for _, rec := range records {
+		var r RMA
+		if json.Unmarshal(rec.Data, &r) == nil {
+			out = append(out, r)
+		}
+	}
+	return out, nil
+}
+
+func (s *Service) ListBackorders() ([]RMA, error) {
+	all, err := s.List()
+	if err != nil {
+		return nil, err
+	}
+	out := make([]RMA, 0)
+	for _, r := range all {
+		if r.Backorder && (r.Status == "OPEN" || r.Status == "RECEIVED") {
+			out = append(out, r)
+		}
+	}
+	return out, nil
+}
+
+func (s *Service) Receive(id int64, actor string) (RMA, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	r, err := s.Get(id)
+	if err != nil {
+		return RMA{}, err
+	}
+	if r.Status != "OPEN" {
+		return RMA{}, fmt.Errorf("rma status %s cannot receive", r.Status)
+	}
+	r.Status = "RECEIVED"
+	r.UpdatedAt = time.Now().UTC()
+	r.Notes = "received by " + actor
+	data, _ := json.Marshal(r)
+	_, err = s.store.Put(kind, formatID(r.RMAID), data)
+	return r, err
+}
+
+func (s *Service) Complete(id int64, actor string) (RMA, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	r, err := s.Get(id)
+	if err != nil {
+		return RMA{}, err
+	}
+	if r.Status != "OPEN" && r.Status != "RECEIVED" {
+		return RMA{}, fmt.Errorf("rma status %s cannot complete", r.Status)
+	}
+	r.Status = "COMPLETED"
+	r.UpdatedAt = time.Now().UTC()
+	r.Notes = "completed by " + actor + "; restock deferred to inventory adjust"
+	data, _ := json.Marshal(r)
+	_, err = s.store.Put(kind, formatID(r.RMAID), data)
+	return r, err
+}
+
+func (s *Service) Cancel(id int64, actor string) (RMA, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	r, err := s.Get(id)
+	if err != nil {
+		return RMA{}, err
+	}
+	if r.Status == "COMPLETED" {
+		return RMA{}, fmt.Errorf("cannot cancel completed rma")
+	}
+	r.Status = "CANCELLED"
+	r.UpdatedAt = time.Now().UTC()
+	r.Notes = "cancelled by " + actor
+	data, _ := json.Marshal(r)
+	_, err = s.store.Put(kind, formatID(r.RMAID), data)
+	return r, err
+}
+
+func formatID(id int64) string { return fmt.Sprintf("%d", id) }
diff --git a/wms-twin/internal/application/snapshot/snapshot.go b/wms-twin/internal/application/snapshot/snapshot.go
new file mode 100644
index 0000000..a73296f
--- /dev/null
+++ b/wms-twin/internal/application/snapshot/snapshot.go
@@ -0,0 +1,35 @@
+package snapshot
+
+import (
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/inventoryledger"
+)
+
+type Service struct {
+	ledger *inventoryledger.Ledger
+}
+
+func New(ledger *inventoryledger.Ledger) *Service { return &Service{ledger: ledger} }
+
+func (s *Service) Inventory(warehouseID int64) (map[string]any, error) {
+	balances, version, err := s.ledger.List()
+	if err != nil {
+		return nil, err
+	}
+	rows := make([]map[string]any, 0, len(balances))
+	for _, b := range balances {
+		if warehouseID != 0 && b.WarehouseID != warehouseID {
+			continue
+		}
+		rows = append(rows, map[string]any{
+			"warehouse_id": b.WarehouseID, "bin_id": b.BinID, "item_id": b.ItemID,
+			"lot_number": b.LotNumber, "on_hand": b.OnHand, "allocated": b.Allocated,
+			"available": b.OnHand - b.Allocated,
+		})
+	}
+	return map[string]any{
+		"version": version, "generated_at": time.Now().UTC(),
+		"rows": rows, "total": len(rows), "engine": "PrismaTec-Core",
+	}, nil
+}
diff --git a/wms-twin/internal/application/webhooks/webhooks.go b/wms-twin/internal/application/webhooks/webhooks.go
new file mode 100644
index 0000000..9cc3150
--- /dev/null
+++ b/wms-twin/internal/application/webhooks/webhooks.go
@@ -0,0 +1,124 @@
+package webhooks
+
+import (
+	"bytes"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"net/http"
+	"sync"
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/corestore"
+)
+
+const kind = "wms_webhook"
+
+type Subscription struct {
+	ID         string    `json:"id"`
+	URL        string    `json:"url"`
+	Secret     string    `json:"secret"`
+	EventTypes []string  `json:"event_types"`
+	Active     bool      `json:"active"`
+	CreatedAt  time.Time `json:"created_at"`
+}
+
+type Service struct {
+	store  *corestore.Store
+	client *http.Client
+	mu     sync.Mutex
+	seq    int64
+}
+
+func New(store *corestore.Store) *Service {
+	return &Service{store: store, client: &http.Client{Timeout: 8 * time.Second}}
+}
+
+func (s *Service) Create(url, secret string, types []string) (Subscription, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.seq++
+	id := "wh_" + formatN(s.seq)
+	sub := Subscription{ID: id, URL: url, Secret: secret, EventTypes: types, Active: true, CreatedAt: time.Now().UTC()}
+	data, _ := json.Marshal(sub)
+	_, err := s.store.Put(kind, id, data)
+	return sub, err
+}
+
+func (s *Service) List() ([]Subscription, error) {
+	records, err := s.store.List(kind)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Subscription, 0, len(records))
+	for _, r := range records {
+		var sub Subscription
+		if json.Unmarshal(r.Data, &sub) == nil {
+			sub.Secret = ""
+			out = append(out, sub)
+		}
+	}
+	return out, nil
+}
+
+func (s *Service) Deliver(eventType string, payload any) {
+	records, err := s.store.List(kind)
+	if err != nil {
+		return
+	}
+	body, _ := json.Marshal(map[string]any{"event_type": eventType, "payload": payload, "ts": time.Now().UTC()})
+	for _, r := range records {
+		var sub Subscription
+		if json.Unmarshal(r.Data, &sub) != nil || !sub.Active {
+			continue
+		}
+		if !matches(sub.EventTypes, eventType) {
+			continue
+		}
+		go s.post(sub, body)
+	}
+}
+
+func (s *Service) post(sub Subscription, body []byte) {
+	req, err := http.NewRequest(http.MethodPost, sub.URL, bytes.NewReader(body))
+	if err != nil {
+		return
+	}
+	mac := hmac.New(sha256.New, []byte(sub.Secret))
+	mac.Write(body)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-WMS-Signature", hex.EncodeToString(mac.Sum(nil)))
+	resp, err := s.client.Do(req)
+	if err != nil {
+		return
+	}
+	_ = resp.Body.Close()
+}
+
+func matches(types []string, eventType string) bool {
+	if len(types) == 0 {
+		return true
+	}
+	for _, t := range types {
+		if t == "*" || t == eventType {
+			return true
+		}
+	}
+	return false
+}
+
+func formatN(n int64) string {
+	const d = "0123456789abcdef"
+	var b [16]byte
+	i := 16
+	for n > 0 {
+		i--
+		b[i] = d[n&15]
+		n >>= 4
+	}
+	if i == 16 {
+		return "0"
+	}
+	return string(b[i:])
+}
diff --git a/wms-twin/internal/application/wmsaudit/audit.go b/wms-twin/internal/application/wmsaudit/audit.go
new file mode 100644
index 0000000..b07133f
--- /dev/null
+++ b/wms-twin/internal/application/wmsaudit/audit.go
@@ -0,0 +1,124 @@
+package wmsaudit
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"sync"
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/corestore"
+	"github.com/yecharlot/PrismaTec-Core/core/audit"
+)
+
+const kind = "wms_audit_chain"
+
+type Entry struct {
+	Seq      int64          `json:"seq"`
+	Time     time.Time      `json:"time"`
+	Actor    string         `json:"actor"`
+	Action   string         `json:"action"`
+	Resource string         `json:"resource,omitempty"`
+	OK       bool           `json:"ok"`
+	Detail   string         `json:"detail,omitempty"`
+	Meta     map[string]any `json:"meta,omitempty"`
+	PrevHash string         `json:"prev_hash"`
+	Hash     string         `json:"hash"`
+}
+
+type Service struct {
+	store *corestore.Store
+	core  *audit.Log
+	mu    sync.Mutex
+	last  string
+	seq   int64
+}
+
+func New(store *corestore.Store, coreLog *audit.Log) *Service {
+	s := &Service{store: store, core: coreLog}
+	s.recoverTip()
+	return s
+}
+
+func (s *Service) recoverTip() {
+	records, err := s.store.List(kind)
+	if err != nil || len(records) == 0 {
+		return
+	}
+	var maxSeq int64
+	var lastHash string
+	for _, r := range records {
+		var e Entry
+		if json.Unmarshal(r.Data, &e) != nil {
+			continue
+		}
+		if e.Seq > maxSeq {
+			maxSeq = e.Seq
+			lastHash = e.Hash
+		}
+	}
+	s.seq = maxSeq
+	s.last = lastHash
+}
+
+func (s *Service) Record(actor, action, resource string, ok bool, detail string, meta map[string]any) (Entry, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.seq++
+	e := Entry{
+		Seq: s.seq, Time: time.Now().UTC(), Actor: actor, Action: action,
+		Resource: resource, OK: ok, Detail: detail, Meta: meta, PrevHash: s.last,
+	}
+	e.Hash = hashEntry(e)
+	s.last = e.Hash
+	data, _ := json.Marshal(e)
+	if _, err := s.store.Put(kind, formatSeq(e.Seq), data); err != nil {
+		return e, err
+	}
+	if s.core != nil {
+		s.core.Record(audit.Event{
+			Type: "wms." + action, Actor: actor, Action: action, OK: ok, Detail: detail, Meta: meta,
+		})
+	}
+	return e, nil
+}
+
+func (s *Service) Recent(n int) ([]Entry, error) {
+	records, err := s.store.List(kind)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]Entry, 0, len(records))
+	for _, r := range records {
+		var e Entry
+		if json.Unmarshal(r.Data, &e) == nil {
+			out = append(out, e)
+		}
+	}
+	for i := 0; i < len(out); i++ {
+		for j := i + 1; j < len(out); j++ {
+			if out[j].Seq < out[i].Seq {
+				out[i], out[j] = out[j], out[i]
+			}
+		}
+	}
+	if n > 0 && len(out) > n {
+		out = out[len(out)-n:]
+	}
+	return out, nil
+}
+
+func hashEntry(e Entry) string {
+	copy := e
+	copy.Hash = ""
+	raw, _ := json.Marshal(copy)
+	sum := sha256.Sum256(raw)
+	return hex.EncodeToString(sum[:])
+}
+
+func formatSeq(seq int64) string {
+	return hex.EncodeToString([]byte{
+		byte(seq >> 56), byte(seq >> 48), byte(seq >> 40), byte(seq >> 32),
+		byte(seq >> 24), byte(seq >> 16), byte(seq >> 8), byte(seq),
+	})
+}
diff --git a/wms-twin/internal/httpapi/integrations.go b/wms-twin/internal/httpapi/integrations.go
new file mode 100644
index 0000000..90f1280
--- /dev/null
+++ b/wms-twin/internal/httpapi/integrations.go
@@ -0,0 +1,575 @@
+package httpapi
+
+import (
+	"errors"
+	"fmt"
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/inbound"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/pos"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/application/rma"
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/security/wmstoken"
+)
+
+func extractBearer(r *http.Request) string {
+	h := strings.TrimSpace(r.Header.Get("Authorization"))
+	if strings.HasPrefix(strings.ToLower(h), "bearer ") {
+		return strings.TrimSpace(h[7:])
+	}
+	if t := strings.TrimSpace(r.Header.Get("X-WMS-Token")); t != "" {
+		return t
+	}
+	return ""
+}
+
+func (s *Server) requireWMSToken(scope string, next func(http.ResponseWriter, *http.Request, wmstoken.TokenRecord)) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if s.wmsTokens == nil {
+			writeJSON(w, 503, map[string]string{"error": "wms tokens not configured"})
+			return
+		}
+		rec, err := s.wmsTokens.Authenticate(extractBearer(r), scope)
+		if err != nil {
+			code, body := wmstoken.FormatAuthError(err)
+			writeJSON(w, code, body)
+			return
+		}
+		if s.wmsAudit != nil {
+			_, _ = s.wmsAudit.Record(rec.TokenID, "wms_token", scope, true, r.Method+" "+r.URL.Path, map[string]any{"token_id": rec.TokenID})
+		}
+		next(w, r, rec)
+	}
+}
+
+func (s *Server) v1Route(w http.ResponseWriter, r *http.Request) {
+	path := strings.Trim(strings.TrimPrefix(r.URL.Path, "/api/v1/"), "/")
+	parts := strings.Split(path, "/")
+	if len(parts) == 0 || parts[0] == "" {
+		writeJSON(w, 404, map[string]string{"error": "not found"})
+		return
+	}
+	switch parts[0] {
+	case "pos":
+		s.posV1(w, r, strings.Join(parts[1:], "/"))
+	case "dockd":
+		s.dockdV1(w, r, strings.Join(parts[1:], "/"))
+	case "inbound":
+		s.inboundV1(w, r, strings.Join(parts[1:], "/"))
+	case "events":
+		s.eventsV1(w, r, strings.Join(parts[1:], "/"))
+	case "snapshot":
+		s.snapshotV1(w, r, strings.Join(parts[1:], "/"))
+	case "webhooks":
+		s.webhooksV1(w, r, strings.Join(parts[1:], "/"))
+	default:
+		writeJSON(w, 404, map[string]string{"error": "not found"})
+	}
+}
+
+func (s *Server) posV1(w http.ResponseWriter, r *http.Request, rest string) {
+	switch {
+	case r.Method == http.MethodGet && rest == "availability":
+		s.requireWMSToken("pos.availability", func(w http.ResponseWriter, r *http.Request, rec wmstoken.TokenRecord) {
+			wid, _ := strconv.ParseInt(r.URL.Query().Get("warehouse_id"), 10, 64)
+			if rec.WarehouseID != nil {
+				wid = *rec.WarehouseID
+			}
+			out, err := s.pos.Availability(wid, r.URL.Query().Get("sku"))
+			if err != nil {
+				writeJSON(w, 500, map[string]string{"error": err.Error()})
+				return
+			}
+			writeJSON(w, 200, out)
+		})(w, r)
+	case r.Method == http.MethodPost && rest == "validate-cart":
+		s.requireWMSToken("pos.validate-cart", func(w http.ResponseWriter, r *http.Request, rec wmstoken.TokenRecord) {
+			var in struct {
+				WarehouseID int64          `json:"warehouse_id"`
+				Lines       []pos.CartLine `json:"lines"`
+			}
+			if err := decodeBody(r, &in); err != nil {
+				writeJSON(w, 400, map[string]string{"error": "Invalid request body"})
+				return
+			}
+			if rec.WarehouseID != nil {
+				in.WarehouseID = *rec.WarehouseID
+			}
+			out, err := s.pos.ValidateCart(in.WarehouseID, in.Lines)
+			if err != nil {
+				writeJSON(w, 400, map[string]string{"error": err.Error()})
+				return
+			}
+			writeJSON(w, 200, out)
+		})(w, r)
+	case r.Method == http.MethodPost && rest == "checkout":
+		s.requireWMSToken("pos.checkout", func(w http.ResponseWriter, r *http.Request, rec wmstoken.TokenRecord) {
+			var in struct {
+				WarehouseID int64          `json:"warehouse_id"`
+				Lines       []pos.CartLine `json:"lines"`
+			}
+			if err := decodeBody(r, &in); err != nil {
+				writeJSON(w, 400, map[string]string{"error": "Invalid request body"})
+				return
+			}
+			if rec.WarehouseID != nil {
+				in.WarehouseID = *rec.WarehouseID
+			}
+			so, err := s.pos.Checkout(in.WarehouseID, in.Lines, rec.Name)
+			if err != nil {
+				writeJSON(w, 400, map[string]string{"error": err.Error()})
+				return
+			}
+			if s.events != nil {
+				_, _ = s.events.Emit("pos.checkout", map[string]any{"so_id": so.SOID, "so_number": so.SONumber})
+			}
+			if s.webhooks != nil {
+				s.webhooks.Deliver("pos.checkout", so)
+			}
+			writeJSON(w, 201, so)
+		})(w, r)
+	case r.Method == http.MethodPost && rest == "refund":
+		s.requireWMSToken("pos.refund", func(w http.ResponseWriter, r *http.Request, rec wmstoken.TokenRecord) {
+			var in struct {
+				SONumber string `json:"so_number"`
+			}
+			if err := decodeBody(r, &in); err != nil {
+				writeJSON(w, 400, map[string]string{"error": "Invalid request body"})
+				return
+			}
+			out, err := s.pos.Refund(in.SONumber, rec.Name)
+			if err != nil {
+				writeJSON(w, 404, map[string]string{"error": err.Error()})
+				return
+			}
+			if s.events != nil {
+				_, _ = s.events.Emit("pos.refund", out)
+			}
+			writeJSON(w, 200, out)
+		})(w, r)
+	case r.Method == http.MethodPost && rest == "dispatch":
+		s.requireWMSToken("pos.dispatch", func(w http.ResponseWriter, r *http.Request, rec wmstoken.TokenRecord) {
+			var in struct {
+				SONumber string `json:"so_number"`
+			}
+			if err := decodeBody(r, &in); err != nil {
+				writeJSON(w, 400, map[string]string{"error": "Invalid request body"})
+				return
+			}
+			out, err := s.pos.Dispatch(in.SONumber, rec.Name)
+			if err != nil {
+				writeJSON(w, 404, map[string]string{"error": err.Error()})
+				return
+			}
+			if s.events != nil {
+				_, _ = s.events.Emit("pos.dispatch", out)
+			}
+			writeJSON(w, 200, out)
+		})(w, r)
+	case r.Method == http.MethodGet && strings.HasPrefix(rest, "sales-orders/"):
+		s.requireWMSToken("pos.sales-orders", func(w http.ResponseWriter, r *http.Request, rec wmstoken.TokenRecord) {
+			num := strings.TrimPrefix(rest, "sales-orders/")
+			so, err := s.pos.GetSO(num)
+			if err != nil {
+				writeJSON(w, 404, map[string]string{"error": "not found"})
+				return
+			}
+			writeJSON(w, 200, so)
+		})(w, r)
+	case r.Method == http.MethodPost && rest == "reference-orders":
+		s.requireWMSToken("pos.reference-orders", func(w http.ResponseWriter, r *http.Request, rec wmstoken.TokenRecord) {
+			writeJSON(w, 200, map[string]any{"orders": []any{}, "note": "reference lookup stub"})
+		})(w, r)
+	default:
+		writeJSON(w, 404, map[string]string{"error": "not found"})
+	}
+}
