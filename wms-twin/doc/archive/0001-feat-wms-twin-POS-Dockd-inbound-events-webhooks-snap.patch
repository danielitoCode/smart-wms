diff --git a/wms-twin/internal/mesh/mesh.go b/wms-twin/internal/mesh/mesh.go
new file mode 100644
index 0000000..45e79b9
--- /dev/null
+++ b/wms-twin/internal/mesh/mesh.go
@@ -0,0 +1,180 @@
+// Package mesh provides a Kademlia-inspired peer table and gossip fan-out
+// on top of PrismaTec-Core network.Transport (Broadcast / OnMessage).
+package mesh
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"sort"
+	"sync"
+	"time"
+
+	"github.com/yecharlot/PrismaTec-Core/network"
+)
+
+const (
+	MsgGossip = "wms.gossip"
+	MsgPing   = "wms.ping"
+)
+
+type Peer struct {
+	NodeID   string    `json:"node_id"`
+	Addr     string    `json:"addr,omitempty"`
+	LastSeen time.Time `json:"last_seen"`
+	Distance string    `json:"distance,omitempty"`
+}
+
+type GossipEnvelope struct {
+	Topic     string          `json:"topic"`
+	MessageID string          `json:"message_id"`
+	Payload   json.RawMessage `json:"payload"`
+	TTL       int             `json:"ttl"`
+	Origin    string          `json:"origin"`
+	SentAt    time.Time       `json:"sent_at"`
+}
+
+type Mesh struct {
+	selfID    string
+	transport network.Transport
+	mu        sync.Mutex
+	peers     map[string]Peer
+	seen      map[string]time.Time
+	handlers  map[string]func(GossipEnvelope)
+}
+
+func New(selfID string, transport network.Transport) *Mesh {
+	m := &Mesh{
+		selfID: selfID, transport: transport,
+		peers: make(map[string]Peer), seen: make(map[string]time.Time),
+		handlers: make(map[string]func(GossipEnvelope)),
+	}
+	if transport != nil {
+		transport.OnMessage(m.onMessage)
+	}
+	return m
+}
+
+func (m *Mesh) onMessage(msg network.Message) {
+	switch msg.Type {
+	case MsgPing:
+		m.mu.Lock()
+		m.peers[msg.From] = Peer{NodeID: msg.From, LastSeen: time.Now().UTC(), Distance: xorDistance(m.selfID, msg.From)}
+		m.mu.Unlock()
+	case MsgGossip:
+		var env GossipEnvelope
+		if err := json.Unmarshal(msg.Payload, &env); err != nil {
+			return
+		}
+		m.handleGossip(env)
+	}
+}
+
+func (m *Mesh) handleGossip(env GossipEnvelope) {
+	m.mu.Lock()
+	if _, ok := m.seen[env.MessageID]; ok {
+		m.mu.Unlock()
+		return
+	}
+	m.seen[env.MessageID] = time.Now().UTC()
+	if len(m.seen) > 5000 {
+		for id, t := range m.seen {
+			if time.Since(t) > time.Hour {
+				delete(m.seen, id)
+			}
+		}
+	}
+	h := m.handlers[env.Topic]
+	m.mu.Unlock()
+	if h != nil {
+		h(env)
+	}
+	if env.TTL > 1 && m.transport != nil {
+		env.TTL--
+		payload, _ := json.Marshal(env)
+		_ = m.transport.Broadcast(context.Background(), network.Message{
+			Type: MsgGossip, From: m.selfID, Payload: payload, SentAt: time.Now().UTC(),
+		})
+	}
+}
+
+func (m *Mesh) OnTopic(topic string, h func(GossipEnvelope)) {
+	m.mu.Lock()
+	m.handlers[topic] = h
+	m.mu.Unlock()
+}
+
+func (m *Mesh) Publish(topic string, payload any) error {
+	raw, err := json.Marshal(payload)
+	if err != nil {
+		return err
+	}
+	sum := sha256.Sum256(append([]byte(topic), raw...))
+	env := GossipEnvelope{
+		Topic: topic, MessageID: hex.EncodeToString(sum[:16]),
+		Payload: raw, TTL: 3, Origin: m.selfID, SentAt: time.Now().UTC(),
+	}
+	m.handleGossip(env)
+	if m.transport == nil {
+		return nil
+	}
+	body, _ := json.Marshal(env)
+	return m.transport.Broadcast(context.Background(), network.Message{
+		Type: MsgGossip, From: m.selfID, Payload: body, SentAt: time.Now().UTC(),
+	})
+}
+
+func (m *Mesh) UpsertPeer(nodeID, addr string) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.peers[nodeID] = Peer{NodeID: nodeID, Addr: addr, LastSeen: time.Now().UTC(), Distance: xorDistance(m.selfID, nodeID)}
+}
+
+func (m *Mesh) Closest(target string, n int) []Peer {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	list := make([]Peer, 0, len(m.peers))
+	for _, p := range m.peers {
+		p.Distance = xorDistance(target, p.NodeID)
+		list = append(list, p)
+	}
+	sort.Slice(list, func(i, j int) bool { return list[i].Distance < list[j].Distance })
+	if n > len(list) {
+		n = len(list)
+	}
+	if n < 0 {
+		n = 0
+	}
+	return list[:n]
+}
+
+func (m *Mesh) Peers() []Peer {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	out := make([]Peer, 0, len(m.peers))
+	for _, p := range m.peers {
+		out = append(out, p)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].NodeID < out[j].NodeID })
+	return out
+}
+
+func (m *Mesh) PingAll(ctx context.Context) {
+	if m.transport == nil {
+		return
+	}
+	_ = m.transport.Broadcast(ctx, network.Message{
+		Type: MsgPing, From: m.selfID, Payload: []byte(`{}`), SentAt: time.Now().UTC(),
+	})
+}
+
+func xorDistance(a, b string) string {
+	ha := sha256.Sum256([]byte(a))
+	hb := sha256.Sum256([]byte(b))
+	var out [32]byte
+	for i := 0; i < 32; i++ {
+		out[i] = ha[i] ^ hb[i]
+	}
+	return hex.EncodeToString(out[:])
+}
diff --git a/wms-twin/internal/security/wmstoken/token.go b/wms-twin/internal/security/wmstoken/token.go
new file mode 100644
index 0000000..12d6ec6
--- /dev/null
+++ b/wms-twin/internal/security/wmstoken/token.go
@@ -0,0 +1,225 @@
+// Package wmstoken implements scoped integration tokens (not JWT user sessions).
+package wmstoken
+
+import (
+	"crypto/rand"
+	"crypto/subtle"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/danielitoCode/smart-wms/wms-twin/internal/corestore"
+	"golang.org/x/crypto/bcrypt"
+)
+
+const kind = "wms_token"
+
+var (
+	ErrUnauthorized = errors.New("invalid or revoked wms token")
+	ErrScope        = errors.New("endpoint_scope_violation")
+	ErrInactive     = errors.New("token inactive")
+)
+
+var KnownScopes = []string{
+	"pos.availability", "pos.validate-cart", "pos.checkout", "pos.refund", "pos.sales-orders", "pos.reference-orders", "pos.dispatch",
+	"dockd.orders", "dockd.items", "dockd.ship", "dockd.void-ship",
+	"inbound.mapping-schema", "inbound.write",
+	"events.read", "events.ack", "snapshot.inventory", "webhooks.manage",
+}
+
+type TokenRecord struct {
+	TokenID     string     `json:"token_id"`
+	Name        string     `json:"name"`
+	SecretHash  string     `json:"secret_hash"`
+	Endpoints   []string   `json:"endpoints"`
+	WarehouseID *int64     `json:"warehouse_id,omitempty"`
+	Active      bool       `json:"active"`
+	CreatedAt   time.Time  `json:"created_at"`
+	LastUsedAt  *time.Time `json:"last_used_at,omitempty"`
+}
+
+type PublicToken struct {
+	TokenID     string    `json:"token_id"`
+	Name        string    `json:"name"`
+	Endpoints   []string  `json:"endpoints"`
+	WarehouseID *int64    `json:"warehouse_id,omitempty"`
+	Active      bool      `json:"active"`
+	CreatedAt   time.Time `json:"created_at"`
+	Token       string    `json:"token,omitempty"`
+}
+
+type Store struct {
+	store *corestore.Store
+	mu    sync.Mutex
+}
+
+func NewStore(store *corestore.Store) *Store { return &Store{store: store} }
+
+func (s *Store) Create(name string, endpoints []string, warehouseID *int64) (PublicToken, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	plain, err := randomToken()
+	if err != nil {
+		return PublicToken{}, err
+	}
+	hash, err := bcrypt.GenerateFromPassword([]byte(plain), 12)
+	if err != nil {
+		return PublicToken{}, err
+	}
+	raw := make([]byte, 8)
+	_, _ = rand.Read(raw)
+	id := "wt_" + hex.EncodeToString(raw)
+	rec := TokenRecord{
+		TokenID: id, Name: strings.TrimSpace(name), SecretHash: string(hash),
+		Endpoints: normalizeScopes(endpoints), WarehouseID: warehouseID,
+		Active: true, CreatedAt: time.Now().UTC(),
+	}
+	data, _ := json.Marshal(rec)
+	if _, err := s.store.Put(kind, rec.TokenID, data); err != nil {
+		return PublicToken{}, err
+	}
+	return PublicToken{
+		TokenID: rec.TokenID, Name: rec.Name, Endpoints: rec.Endpoints,
+		WarehouseID: rec.WarehouseID, Active: true, CreatedAt: rec.CreatedAt, Token: plain,
+	}, nil
+}
+
+func (s *Store) Authenticate(plain, requiredScope string) (TokenRecord, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	plain = strings.TrimSpace(plain)
+	if plain == "" {
+		return TokenRecord{}, ErrUnauthorized
+	}
+	records, err := s.store.List(kind)
+	if err != nil {
+		return TokenRecord{}, err
+	}
+	for _, r := range records {
+		var rec TokenRecord
+		if err := json.Unmarshal(r.Data, &rec); err != nil {
+			continue
+		}
+		if err := bcrypt.CompareHashAndPassword([]byte(rec.SecretHash), []byte(plain)); err != nil {
+			continue
+		}
+		if !rec.Active {
+			return TokenRecord{}, ErrInactive
+		}
+		if requiredScope != "" && !scopeAllows(rec.Endpoints, requiredScope) {
+			return TokenRecord{}, ErrScope
+		}
+		now := time.Now().UTC()
+		rec.LastUsedAt = &now
+		data, _ := json.Marshal(rec)
+		_, _ = s.store.Put(kind, rec.TokenID, data)
+		return rec, nil
+	}
+	return TokenRecord{}, ErrUnauthorized
+}
+
+func (s *Store) List() ([]PublicToken, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	records, err := s.store.List(kind)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]PublicToken, 0, len(records))
+	for _, r := range records {
+		var rec TokenRecord
+		if err := json.Unmarshal(r.Data, &rec); err != nil {
+			continue
+		}
+		out = append(out, PublicToken{
+			TokenID: rec.TokenID, Name: rec.Name, Endpoints: rec.Endpoints,
+			WarehouseID: rec.WarehouseID, Active: rec.Active, CreatedAt: rec.CreatedAt,
+		})
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].CreatedAt.Before(out[j].CreatedAt) })
+	return out, nil
+}
+
+func (s *Store) Revoke(tokenID string) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	recRaw, ok, err := s.store.Get(kind, tokenID)
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return fmt.Errorf("token not found")
+	}
+	var rec TokenRecord
+	if err := json.Unmarshal(recRaw.Data, &rec); err != nil {
+		return err
+	}
+	rec.Active = false
+	data, _ := json.Marshal(rec)
+	_, err = s.store.Put(kind, tokenID, data)
+	return err
+}
+
+func scopeAllows(have []string, need string) bool {
+	need = strings.TrimSpace(need)
+	for _, s := range have {
+		if s == "*" || s == need {
+			return true
+		}
+		if strings.HasSuffix(s, ".*") && strings.HasPrefix(need, strings.TrimSuffix(s, ".*")+".") {
+			return true
+		}
+	}
+	return false
+}
+
+func normalizeScopes(in []string) []string {
+	seen := map[string]struct{}{}
+	out := make([]string, 0, len(in))
+	for _, s := range in {
+		s = strings.TrimSpace(s)
+		if s == "" {
+			continue
+		}
+		if _, ok := seen[s]; ok {
+			continue
+		}
+		seen[s] = struct{}{}
+		out = append(out, s)
+	}
+	if len(out) == 0 {
+		return []string{"*"}
+	}
+	sort.Strings(out)
+	return out
+}
+
+func randomToken() (string, error) {
+	b := make([]byte, 32)
+	if _, err := rand.Read(b); err != nil {
+		return "", err
+	}
+	return "wms_" + hex.EncodeToString(b), nil
+}
+
+func ConstantTimeMatch(a, b string) bool {
+	return subtle.ConstantTimeCompare([]byte(a), []byte(b)) == 1
+}
+
+func FormatAuthError(err error) (int, map[string]string) {
+	switch {
+	case errors.Is(err, ErrScope):
+		return 403, map[string]string{"error": "endpoint_scope_violation"}
+	case errors.Is(err, ErrInactive):
+		return 403, map[string]string{"error": "token_inactive"}
+	case errors.Is(err, ErrUnauthorized):
+		return 401, map[string]string{"error": "Unauthorized"}
+	default:
+		return 500, map[string]string{"error": fmt.Sprint(err)}
+	}
+}
