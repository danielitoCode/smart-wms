# Leave empty in local Vite dev so the browser calls same-origin `/api/*`
# and vite.config.ts proxies to the Docker API on :5000 (avoids CORS).
VITE_API_BASE_URL=

# Only set a full URL when the UI is hosted on a different origin than the API
# (and that origin is listed in the API CORS_ORIGINS env).
# VITE_API_BASE_URL=http://localhost:5000
