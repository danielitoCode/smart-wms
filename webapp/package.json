{
  "name": "webapp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.9.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#core/*": "./src/core/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:domain": "vitest run src/test/domain",
    "test:application": "vitest run src/test/unitTest/feature/auth/domain/usecase src/test/unitTest/feature/inventory/domain/usecase src/test/unitTest/feature/items/domain/usecase src/test/unitTest/feature/packing/domain/usecase src/test/unitTest/feature/picking/domain/usecase src/test/unitTest/feature/putaway/domain/usecase src/test/unitTest/feature/receiving/domain/usecase src/test/unitTest/feature/shipping/domain/usecase src/test/unitTest/feature/warehouses/domain/usecase src/test/unitTest/feature/vendors/domain/usecase",
    "test:infrastructure": "vitest run src/test/unitTest/infrastructure src/test/unitTest/feature/infrastructure src/test/unitTest/feature/warehouses/data/mapper src/test/unitTest/feature/vendors/data/mapper",
    "test:ui": "vitest run src/lib/i18n",
    "test:integration": "vitest run src/test/integration",
    "test:all": "vitest run"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^3.2.4",
    "@types/node": "^26.0.0"
  }
}
