{
  "name": "webapp",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.9.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#core/*": "./src/core/*",
    "#shared/*": "./src/shared/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:domain": "vitest run src/test/domain src/test/unitTest/feature/*/domain src/test/unitTest/feature/admin-operations/domain",
    "test:application": "vitest run src/test/unitTest/feature/*/domain/usecase src/test/unitTest/feature/*/domain/policy src/test/unitTest/feature/admin-operations/domain/usecase",
    "test:infrastructure": "vitest run src/test/unitTest/infrastructure src/test/unitTest/feature/infrastructure src/test/unitTest/feature/*/data",
    "test:ui": "vitest run src/lib/i18n src/test/unitTest/feature/*/ui",
    "test:integration": "vitest run src/test/integration",
    "test:all": "vitest run",
    "test:i18n": "vitest run src/lib/i18n",
    "test:coverage": "vitest run --coverage",
    "test:coverage:feature": "vitest run --coverage --coverage.reporter=json-summary --coverage.reporter=text-summary"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-svelte": "0.10.15",
    "cobe": "^2.0.1",
    "svg-dotted-map": "^2.1.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.48.5",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.10.0",
    "svelte": "^5.43.8",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
